{
  "version": 1,
  "sdk_version": "0.25.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://skupelrvihfgyylfklmk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "proyecto-nexus",
      "version": "0.1.0",
      "title": "Proyecto Nexus"
    },
    "tools": [
      {
        "name": "buscar_empresas",
        "title": "Buscar empresas",
        "description": "Busca empresas del radar comercial por nombre, CIF, sector, localidad u operador y devuelve sus datos clave (líneas, score, estado telecom).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Texto a buscar en nombre, CIF, sector o localidad."
            },
            "limit": {
              "default": 20,
              "description": "Máximo de resultados (1-50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "ficha_empresa",
        "title": "Ficha de empresa",
        "description": "Devuelve la ficha completa de una empresa (datos telecom, contactos, decisores), sus sedes, su lead en el pipeline y sus ventas cerradas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "company_id": {
              "type": "string",
              "minLength": 1,
              "description": "ID de la empresa (campo id de companies)."
            }
          },
          "required": [
            "company_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "listar_pipeline",
        "title": "Listar pipeline",
        "description": "Lista los leads del pipeline comercial del usuario, opcionalmente filtrados por estado (sin_empezar, contactado, cualificado, propuesta, negociacion, ganado, perdido).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "estado": {
              "description": "Estado del pipeline por el que filtrar.",
              "type": "string",
              "enum": [
                "sin_empezar",
                "contactado",
                "cualificado",
                "propuesta",
                "negociacion",
                "ganado",
                "perdido"
              ]
            },
            "limit": {
              "default": 50,
              "description": "Máximo de leads a devolver.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "actualizar_lead",
        "title": "Actualizar lead del pipeline",
        "description": "Cambia el estado del pipeline de un lead y/o su próxima acción y notas. Escribe únicamente en la tabla leads.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "lead_id": {
              "type": "string",
              "minLength": 1,
              "description": "ID del lead a actualizar."
            },
            "estado": {
              "description": "Nuevo estado del pipeline.",
              "type": "string",
              "enum": [
                "sin_empezar",
                "contactado",
                "cualificado",
                "propuesta",
                "negociacion",
                "ganado",
                "perdido"
              ]
            },
            "next_action": {
              "description": "Próxima acción comercial.",
              "type": "string",
              "maxLength": 500
            },
            "next_action_date": {
              "description": "Fecha de la próxima acción (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "notas": {
              "description": "Notas del lead.",
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "lead_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "registrar_venta",
        "title": "Registrar venta cerrada",
        "description": "Registra una venta cerrada de una empresa (líneas móvil, fibras, SNAV, margen y si es producto estratégico). Alimenta los KPIs del trimestre en la pestaña Hoy.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "company_id": {
              "type": "string",
              "minLength": 1,
              "description": "ID de la empresa."
            },
            "lineas_movil": {
              "default": 0,
              "description": "Altas de líneas móviles.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lineas_fibra": {
              "default": 0,
              "description": "Altas de fibras.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "snav": {
              "default": 0,
              "description": "SNAV en euros.",
              "type": "number",
              "minimum": 0
            },
            "margen": {
              "default": 0,
              "description": "Margen en euros.",
              "type": "number",
              "minimum": 0
            },
            "producto": {
              "description": "Producto vendido.",
              "type": "string",
              "maxLength": 200
            },
            "producto_estrategico": {
              "default": false,
              "description": "Si es producto estratégico acelerador.",
              "type": "boolean"
            },
            "fecha": {
              "description": "Fecha de la venta (YYYY-MM-DD). Por defecto hoy.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "notas": {
              "description": "Notas de la venta.",
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": [
            "company_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "kpis_ventas",
        "title": "KPIs de ventas del periodo",
        "description": "Agrega las ventas cerradas en un rango de fechas: altas de líneas móviles y fibras, SNAV total, margen total y rentabilidad media por línea.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "desde": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Fecha inicial (YYYY-MM-DD)."
            },
            "hasta": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Fecha final (YYYY-MM-DD)."
            }
          },
          "required": [
            "desde",
            "hasta"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
